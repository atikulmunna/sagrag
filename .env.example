# NOTE: HF_CACHE_DIR is a Docker Compose interpolation var, not a backend runtime
# var. Set it in infra/.env (the compose file's directory), not here. On Windows
# use forward slashes, e.g. HF_CACHE_DIR=C:/Users/<you>/.cache/huggingface
# If unset, compose falls back to ./hf_cache next to the compose file.

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
# LLM HTTP timeouts; the stream deadline bounds one whole streamed answer.
LLM_CONNECT_TIMEOUT_S=5
LLM_READ_TIMEOUT_S=60
SYNTHESIS_STREAM_TIMEOUT_S=90
# The original query is always searched; at most this many queries fan out.
PLANNER_MAX_QUERIES=4
# Check each answer sentence against its cited passages with a local NLI model
# (downloads ~330 MB on first use). Hallucination risk is then measured.
VERIFY_ENABLED=false
VERIFY_THRESHOLD=0.5
# Withhold answers with less than this share of supported sentences (0 = off).
ABSTAIN_BELOW_SUPPORT=0

QDRANT_URL=http://qdrant:6333
ELASTIC_URL=http://elastic:9200
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# The neo4j container reads its password from infra/.env (compose interpolation);
# keep the two in sync when GRAPH_ENABLED=true.
NEO4J_PASSWORD=changeme

GRAPH_ENABLED=false

DOMAIN_KEYWORDS={"stoicism":["stoic","seneca","epictetus","marcus"],"finance":["earnings","revenue","sec"]}
DOMAIN_MIN_KEYWORD_HITS=2
QUERY_TERM_SYNONYMS={"fear":["dread","terror","anxiety","timor","metus"]}
AUTHOR_INDEX_PATH=/data/author_index.json
MIN_RESULTS_COUNT=3
MIN_TOP_RERANK_SCORE=-12.0
DOMAIN_ALIASES={"stoicism":["stoicism","stoic"],"finance":["financial","fintech"]}

POLICY_BLOCKLIST=
POLICY_ALLOWLIST=
POLICY_SOURCE_TYPES_ALLOW=
POLICY_SOURCE_TYPES_BLOCK=
POLICY_DOMAINS_ALLOW=
POLICY_DOMAINS_BLOCK=
POLICY_RULES=[{"action":"deny","domains":["stoicism"],"contains":["spoiler"]}]

OTEL_ENABLED=false
OTEL_SERVICE_NAME=sag-rag-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

ENABLE_JUDGE=true
ENABLE_SYNTHESIS=true
JUDGE_MAX_TOKENS=150
SYNTHESIS_MAX_TOKENS=250
JUDGE_TIMEOUT_S=8
SYNTHESIS_TIMEOUT_S=12
RATE_LIMIT_PER_MINUTE=60
# Reverse proxies whose X-Forwarded-For entries are trusted (compose sets 1 for
# the web container's nginx). 0 = use the socket peer address.
TRUSTED_PROXY_HOPS=0
LLM_MAX_CONCURRENT=2
TENANT_ISOLATION=false
# Comma-separated browser origins allowed to call the API directly. Not needed
# when the web UI is served by the bundled nginx (same origin).
CORS_ORIGINS=

# API-key auth (opt-in). When AUTH_ENABLED=true, every endpoint except /health,
# /ready and /metrics requires an `x-api-key` header. NEVER commit real keys: set
# them here in your local .env (git-ignored) or via a secret store / Docker
# secrets. Enable TENANT_ISOLATION=true alongside to bind each key to its own
# tenant namespace, enforced server-side (a body-supplied "tenant" is ignored
# for authenticated requests).
AUTH_ENABLED=false
# Comma-separated keys; a key without an API_KEY_MAP entry gets a tenant id
# derived from a hash of the key (the key itself is never stored).
API_KEYS=
# Optional explicit key -> tenant map (JSON). Overrides the API_KEYS default.
API_KEY_MAP={}
